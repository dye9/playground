{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "serena": {
      "command": "uvx",
      "args": ["-p", "3.13", "--from", "serena-agent", "serena", "start-mcp-server", "--context", "claude-code", "--project-from-cwd"]
    }
  }
}
